{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        { "src": "package.json", "dest": "package.json" },
        { "src": "package-lock.json", "dest": "package-lock.json" },
        { "src": "prisma", "dest": "prisma" },
        "npm install"
      ]
    }
  },
  "deploy": {
    "startCommand": "node .next/standalone/server.js",
    "variables": {
      "HOSTNAME": "0.0.0.0"
    }
  }
}
