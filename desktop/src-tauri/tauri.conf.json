{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freenances",
  "version": "0.1.0",
  "identifier": "com.freenances.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:3847",
    "frontendDist": "../runtime/app/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/": "runtime/"
    }
  }
}
