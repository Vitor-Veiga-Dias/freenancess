generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContextType {
  PERSONAL
  BUSINESS
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum DomainEventType {
  TRANSACTION_SYNCED
  LEAKAGE_DETECTED
  CONSENT_EXPIRING
  CONNECTION_ESTABLISHED
  CONNECTION_REVOKED
}

enum MoneyFlowType {
  OBLIGATIONS
  RESERVES
  DISCRETIONARY
  INVESTMENT
}

enum PaymentMode {
  CASH
  CREDIT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  accounts          Account[]
  financialContexts FinancialContext[]
  bankConnections   BankConnection[]
  domainEvents      DomainEvent[]
  simulations       Simulation[]
  manualEntries     ManualEntry[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model FinancialContext {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ContextType
  label     String
  cnpj      String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  bankAccounts    BankAccount[]
  transactions    Transaction[]
  intents         Intent[]
  flowAllocations FlowAllocation[]
  bankConnections BankConnection[]
  manualEntries   ManualEntry[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, type])
  @@map("financial_context")
}

model BankConnection {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextId        String           @map("context_id")
  context          FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  providerItemId   String           @unique @map("provider_item_id")
  institutionName  String           @map("institution_name")
  status           ConnectionStatus @default(PENDING)
  scopes           String[]
  consentExpiresAt DateTime?        @map("consent_expires_at")
  lastSyncedAt     DateTime?        @map("last_synced_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  bankAccounts BankAccount[]

  @@map("bank_connection")
}

model BankAccount {
  id           String           @id @default(cuid())
  connectionId String           @map("connection_id")
  connection   BankConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contextId    String           @map("context_id")
  context      FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  providerId   String           @map("provider_id")
  name         String
  type         String
  balance      Decimal          @default(0) @db.Decimal(18, 2)
  currency     String           @default("BRL")
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  transactions Transaction[]

  @@unique([providerId])
  @@map("bank_account")
}

model Transaction {
  id           String           @id @default(cuid())
  accountId    String           @map("account_id")
  account      BankAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contextId    String           @map("context_id")
  context      FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  sourceId     String           @unique @map("source_id")
  type         TransactionType
  amount       Decimal          @db.Decimal(18, 2)
  description  String
  category     String?
  merchantName String?          @map("merchant_name")
  postedAt     DateTime         @map("posted_at")
  isClassified Boolean          @default(false) @map("is_classified")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  flowAllocations FlowAllocation[]

  @@index([contextId, postedAt])
  @@map("transaction")
}

model FlowAllocation {
  id            String           @id @default(cuid())
  transactionId String           @map("transaction_id")
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  contextId     String           @map("context_id")
  context       FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  flowType      MoneyFlowType    @map("flow_type")
  amount        Decimal          @db.Decimal(18, 2)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@map("flow_allocation")
}

model Intent {
  id           String           @id @default(cuid())
  contextId    String           @map("context_id")
  context      FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal          @map("target_amount") @db.Decimal(18, 2)
  spentAmount  Decimal          @default(0) @map("spent_amount") @db.Decimal(18, 2)
  deadline     DateTime?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("intent")
}

model DomainEvent {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DomainEventType
  title     String
  narrative String
  metadata  Json?
  readAt    DateTime?       @map("read_at")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("domain_event")
}

model Simulation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  premises  Json
  results   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation")
}

model ManualEntry {
  id                     String           @id @default(cuid())
  userId                 String           @map("user_id")
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextId              String           @map("context_id")
  context                FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  type                   TransactionType
  category               String
  amount                 Decimal          @db.Decimal(18, 2)
  description            String
  postedAt               DateTime         @map("posted_at")
  paymentMode            PaymentMode      @default(CASH) @map("payment_mode")
  installmentNumber      Int?             @map("installment_number")
  installmentTotal       Int?             @map("installment_total")
  isRecurring            Boolean          @default(false) @map("is_recurring")
  counterparty           String?
  fundedByIncomeCategory String?          @map("funded_by_income_category")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  @@index([contextId, postedAt])
  @@index([userId, postedAt])
  @@map("manual_entry")
}

model CategoryBudget {
  id          String           @id @default(cuid())
  contextId   String           @map("context_id")
  context     FinancialContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  category    String
  month       String
  limitAmount Decimal          @map("limit_amount") @db.Decimal(18, 2)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([contextId, category, month])
  @@map("category_budget")
}
